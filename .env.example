# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# --- AI providers (server only, never exposed to the browser) ---
# https://console.groq.com/keys
GROQ_API_KEY=
# Optional: unlocks YouTube links (https://aistudio.google.com/apikey; some accounts need billing)
GEMINI_API_KEY=
# local (free TF-IDF, default) | gemini (neural embeddings, needs a working Gemini key)
# EMBEDDINGS_PROVIDER=local

# --- Optional model overrides (defaults shown) ---
# GROQ_STT_MODEL=whisper-large-v3-turbo
# GROQ_LLM_MODEL=openai/gpt-oss-120b
# GROQ_FAST_MODEL=openai/gpt-oss-20b
# GEMINI_LLM_MODEL=gemini-3.8-flash
# GEMINI_EMBED_MODEL=gemini-embedding-001

# --- Free plan limits ---
# RECAP_DAILY_LIMIT=3
# RECAP_MAX_MINUTES=60

# Public recap shown as "Try a sample" on the landing page (a recap you made public)
# NEXT_PUBLIC_SAMPLE_RECAP_ID=
